[Unit]
Description=Warplet link shortener
After=network.target

[Service]
Type=simple
# Adjust this path if you clone/copy the project somewhere else:
WorkingDirectory=/home/pi/warplet
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

# --- Configuration ---
# Replace with a long random string. You can generate one with:
#   openssl rand -hex 32
Environment=ACCESS_TOKEN=REPLACE_WITH_YOUR_OWN_LONG_RANDOM_TOKEN
Environment=PORT=8787
Environment=DATA_FILE=/home/pi/warplet/data/links.json

# Optional — only needed for multiple-domain support. Comma-separated,
# no spaces. Leave commented out for normal single-domain use.
# Environment=DOMAINS=go.example.com,short.example.org

[Install]
WantedBy=multi-user.target
